        </svg>`,Ge={"#A7BDF7":"#666666","#5A85F8":"#CCCCCC","#81A1F7":"#999999","#4A7AF9":"#E0E0E0","#618BF8":"#C2C2C2","#4374F9":"#EBEBEB","#3C70F9":"#F3F3F3",white:"var(--widget-disabled-background)"},ao=Xe.replace(/fill="([^"]+)"/g,(p,r)=>Ge[r]?`fill="${Ge[r]}"`:p);function so(p){return p.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;")}function lo(p,r){if(!r)return p;let m=so(r);return p.replace("<svg ",`<svg class="${m}" `)}function je(p={}){let{className:r,variant:m="brand"}=p,v=po[m];return lo(v,r)}var po={brand:Xe,overlay:io,disabled:ao};function Ve({createElement:p,appendChild:r,setAttribute:m,attachShadow:v,addEventListener:u,showPopover:d,hidePopover:h,hostTag:s,hostStyle:L,setBlocked:P}){let f=!1,b,Y=()=>{if(b){try{h(b)}catch{}b.remove(),b=null,P(!1)}},S=()=>{if(!f||b||document.readyState==="loading"||!document.body)return;b=p(`${s}-terms`),m(b,"style",L),m(b,"popover","manual");let B=v(b,{mode:"closed"}),et=p("style");et.textContent=`
            :host { all:initial; direction:ltr; }
            :host::backdrop { background:transparent; }
            * { box-sizing:border-box; }
            .glass { position:fixed; inset:0; width:100vw; height:100vh; height:100dvh;
                display:grid; place-items:center; padding:24px; overflow:auto;
                background:rgba(233,240,250,.48); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px);
                pointer-events:auto; overscroll-behavior:contain;
                color:#1e293b; font:16px/1.65 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif; }
            .card { width:100%; max-width:460px; padding:40px 36px;
                border:1px solid rgba(255,255,255,.9); border-radius:24px;
                background:rgba(255,255,255,.84); box-shadow:0 24px 80px rgba(30,41,59,.16),inset 0 1px 0 #fff;
                text-align:center; outline:none; }
            .brand { display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:24px; }
            .logo, .logo svg { display:block; width:44px; height:44px; flex:none; }
            h1 { margin:0; color:#1e293b; font-size:28px; font-weight:700; letter-spacing:-.8px; line-height:1.2; }
            p { margin:0; color:#475569; }
            p + p { margin-top:16px; }
            strong { font-weight:650; color:#334155; }
            a { color:#315fd8; text-decoration:underline; text-underline-offset:3px; }
            a:focus-visible { outline:3px solid #6d9afc; outline-offset:4px; border-radius:2px; }
            @media(max-width:480px) { .glass { padding:20px; } .card { padding:32px 24px; }
