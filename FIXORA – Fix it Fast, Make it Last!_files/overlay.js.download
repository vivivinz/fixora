            :host { all: initial; direction: ltr; }
            * { box-sizing: border-box; }
            .layer { position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh;
                overflow: auto; direction: ltr; text-align: left; color: #173450;
                font: 16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
                pointer-events: auto; overscroll-behavior: contain; }
            .scrim { position: fixed; inset: 0; background: rgba(15,23,42,.52); }
            .banner { position: relative; z-index: 1; width: 100%;
                padding: max(24px, env(safe-area-inset-top)) clamp(22px, 4vw, 40px) 24px;
                border-bottom: 1px solid #cbdcf0; background: #eef5ff;
                box-shadow: 0 6px 24px #0f172a1a; }
            .inner { max-width: 1280px; margin: auto; display: flex; align-items: center;
                justify-content: space-between; gap: 32px; }
            .message { display: flex; gap: 14px; align-items: flex-start; min-width: 0; }
            .icon { display: flex; flex: 0 0 38px; align-items: center; justify-content: center;
                gap: 4px; width: 38px; height: 38px; margin-top: 2px;
                border-radius: 11px; background: #dceaff; }
            .icon::before, .icon::after { content: ""; width: 4px; height: 15px;
                border-radius: 1px; background: #315b83; }
            .content { min-width: 0; }
            h2 { margin: 0 0 6px; color: #173450; font-size: 24px;
                font-weight: 700; letter-spacing: -.4px; line-height: 1.25; }
            p { margin: 0; color: #4b627c; font-size: 16px; line-height: 1.5; }
            .actions { display: grid; gap: 8px; flex: 0 0 204px; text-align: center; }
            .owner { color: #4b627c; font-size: 12px; line-height: 1.4; }
            .primary { display: flex; align-items: center; justify-content: center; gap: 12px;
                min-height: 46px; padding: 12px 20px; border-radius: 9px; background: #1d64cf;
                color: #fff; font-size: 14px; font-weight: 650; line-height: 1.4; text-decoration: none; }
            .primary:hover { background: #1959b9; }
            .secondary { color: #3c628a; font-size: 12px; line-height: 1.5;
                text-underline-offset: 3px; min-height: 20px; }
            a:focus-visible { outline: 3px solid #0891b2; outline-offset: 4px; }
            @media (max-width: 600px) {
                .banner { padding: calc(env(safe-area-inset-top) + 24px) 22px 20px; }
                .inner { display: block; }
                .message { gap: 12px; }
                .icon { width: 34px; height: 34px; flex-basis: 34px; border-radius: 10px; margin-top: 0; }
                h2 { font-size: 21px; margin-bottom: 7px; }
                p { font-size: 14px; line-height: 1.55; }
                .actions { margin-top: 20px; gap: 9px; }
                .primary { min-height: 48px; font-size: 15px; }
                .secondary { display: flex; align-items: center; justify-content: center; min-height: 28px; }
            }
